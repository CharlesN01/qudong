.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f5f7fb;
  color: #223954;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.top {
  flex: none;
  height: 104rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #e8edf4;
  background: #ffffff;
}
.back {
  width: 130rpx;
  color: #5278ba;
  font-size: 26rpx;
}
.top-title {
  flex: 1;
  text-align: center;
  color: #223954;
  font-size: 32rpx;
  font-weight: 700;
}
.top-space {
  width: 130rpx;
}

.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 30rpx 28rpx 36rpx;
}

.bookline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0 4rpx 24rpx;
}
.bookline-name {
  min-width: 0;
  overflow: hidden;
  color: #748195;
  font-size: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bookline-count {
  flex: none;
  color: #5278ba;
  font-size: 22rpx;
  font-weight: 600;
}

.card {
  flex: 1;
  min-height: 720rpx;
  display: flex;
  flex-direction: column;
  padding: 40rpx 34rpx 32rpx;
  border: 2rpx solid #e4e9f1;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(40, 59, 88, 0.045);
}
.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.badge {
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  background: #e9f1ff;
  color: #5278ba;
  font-size: 22rpx;
}
.card-actions {
  flex: none;
  margin-left: auto;
  display: flex;
  gap: 10rpx;
}
.k-icon {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #dfe9f3;
  border-radius: 14rpx;
  background: #f8fbfe;
  color: #8395a8;
  font-size: 28rpx;
  line-height: 1;
}
.k-icon-on {
  border-color: #e6bd68;
  background: #fff4df;
  color: #bc842d;
}

.prompt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 34rpx 0 16rpx;
}
.prompt {
  display: block;
  color: #8793a4;
  font-size: 22rpx;
}
.answer-toggle {
  flex: none;
  color: #8793a4;
  font-size: 22rpx;
}
.question {
  display: block;
  color: #304158;
  font-size: 36rpx;
  line-height: 1.65;
  word-break: break-word;
}

.answer {
  margin-top: 30rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #f2f6fc;
}
.answer-title {
  display: block;
  margin-bottom: 12rpx;
  color: #5278ba;
  font-size: 24rpx;
  font-weight: 600;
}
.answer-text {
  display: block;
  color: #435a75;
  font-size: 28rpx;
  line-height: 1.8;
}
.keys {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.key {
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: #fff4e8;
  color: #a36a2e;
  font-size: 22rpx;
}

.answer-hidden {
  margin-top: 30rpx;
  padding: 46rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d6e2f0;
  border-radius: 16rpx;
  background: #fafcff;
}
.answer-hidden-text {
  color: #8ba3c4;
  font-size: 26rpx;
}

.nav {
  display: flex;
  gap: 18rpx;
  margin-top: auto;
  padding-top: 40rpx;
}
.nav-btn {
  height: 80rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e1eaf5;
  border-radius: 16rpx;
  background: #ffffff;
  color: #5278ba;
  font-size: 26rpx;
}
.nav-btn-off {
  opacity: 0.42;
}

.bottom-tools {
  margin-top: 24rpx;
}
.page-select {
  height: 80rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #e4e9f1;
  border-radius: 16rpx;
  background: #ffffff;
  color: #304158;
  font-size: 26rpx;
}
.page-select-arrow {
  color: #8ba3c4;
  font-size: 22rpx;
}

/* ---------- 本册条目弹层 ---------- */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  background: rgba(28, 44, 64, 0.42);
}
.sheet {
  width: 100%;
  max-height: 76vh;
  overflow: auto;
  padding: 26rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.sheet-title {
  color: #223954;
  font-size: 30rpx;
  font-weight: 700;
}
.sheet-close {
  padding: 0 10rpx;
  color: #7b8ba0;
  font-size: 40rpx;
  line-height: 1;
}
.sheet-hint {
  display: block;
  margin: 10rpx 0 22rpx;
  color: #8793a4;
  font-size: 20rpx;
}
.card-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 14rpx;
}
.card-cell {
  position: relative;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #e0e6ed;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #314760;
  font-size: 23rpx;
  font-weight: 600;
}
.card-cell-on {
  border-color: #9cbef0;
  background: #e9f1ff;
  color: #2f5ea8;
}
.card-cell-mark {
  position: absolute;
  top: 5rpx;
  right: 9rpx;
  color: #e0a544;
  font-size: 17rpx;
  line-height: 1;
}

.tap-dim {
  opacity: 0.88;
}
