/* 题库列表页：对齐「进入第二个刷题页面」HTML（设计宽 480px，按 750/480≈1.5625 换算，并整体放大一档） */

page { background: #F1F7FF; }

.status-pad { width: 100%; background: #F1F7FF; }

.list-page {
  min-height: 100vh;
  padding: 0 24rpx 40rpx;
  background: #F1F7FF;
  color: #20354F;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

/* ---------- 顶部操作 ---------- */
.nav-row { display: flex; align-items: center; }
.back-pill {
  flex: 0 0 auto;
  padding: 11rpx 24rpx 11rpx 20rpx;
  border: 2rpx solid #D8E5F5;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #3D5F91;
  font-size: 22rpx;
  font-weight: 600;
  line-height: normal;
}
.clear-btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  padding: 0 22rpx;
  border: 2rpx solid #DCE8F5;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #52677F;
  font-size: 20rpx;
  font-weight: 600;
  line-height: normal;
}
.pill-pressed { opacity: .72; }

.heading { padding: 18rpx 4rpx 22rpx; }
.heading-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.heading-title { display: block; color: #20354F; font-size: 36rpx; font-weight: 750; line-height: 1.3; }
.heading-sub { display: block; margin-top: 8rpx; color: #74879D; font-size: 20rpx; }

/* ---------- 筛选卡 ---------- */
.filters {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  padding: 18rpx;
  border: 2rpx solid #DCE8F5;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(86, 119, 154, .06);
}
.field { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.field-search { grid-column: 1 / -1; }
.field-label { flex: 0 0 auto; color: #41566F; font-size: 19rpx; white-space: nowrap; }
.field-control { flex: 1; min-width: 0; }
.picker-value {
  height: 62rpx;
  display: flex;
  align-items: center;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: #F3F7FB;
  color: #23384F;
  font-size: 19rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.search-input {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #F3F7FB;
  color: #23384F;
  font-size: 19rpx;
}
.search-holder { color: #98A6B5; }
.search-clear { flex: 0 0 auto; padding: 0 8rpx; color: #98A6B5; font-size: 30rpx; line-height: 1; }

/* ---------- 状态筛选 ---------- */
.statusbar {
  margin: 16rpx 0;
  padding: 16rpx 18rpx 10rpx;
  border: 2rpx solid #DCE8F5;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(86, 119, 154, .06);
}
.statuses { display: flex; flex-wrap: wrap; gap: 10rpx; }
.status {
  padding: 10rpx 16rpx;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  background: #F1F4F7;
  color: #5F7185;
  font-size: 19rpx;
  font-weight: 550;
  line-height: normal;
  white-space: nowrap;
}
.status-on {
  border-color: #CDE1F6;
  background: #E5F1FF;
  color: #286EAF;
  font-weight: 700;
}
.status-count { color: inherit; opacity: .72; }
.result-summary { margin-top: 12rpx; text-align: right; color: #7B8BA0; font-size: 18rpx; }

/* ---------- 题号网格 ---------- */
.grid-panel {
  padding: 22rpx 18rpx 20rpx;
  border: 2rpx solid #DCE8F5;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(86, 119, 154, .06);
}
.grid-head { display: flex; align-items: center; justify-content: space-between; margin: 0 2rpx 16rpx; }
.grid-title { color: #20354F; font-size: 26rpx; font-weight: 700; }
.grid-hint { color: #788BA1; font-size: 18rpx; }

.question-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 12rpx;
}
.question {
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 1.12;
  border: 2rpx solid #E0E6ED;
  border-radius: 12rpx;
  background: #F8FAFC;
  color: #314760;
  font-size: 24rpx;
  font-weight: 600;
  position: relative;
}
.q-done { border-color: #B7DECE; background: #E8F5EE; color: #28775B; }
.q-wrong { border-color: #EDC7CA; background: #FBEFEF; color: #AD525C; }
.q-fav::after {
  content: '';
  position: absolute;
  top: 7rpx;
  right: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #E0A83E;
}
.q-pressed { transform: scale(.96); }

.empty { display: flex; flex-direction: column; align-items: center; gap: 10rpx; padding: 60rpx 20rpx; }
.empty-strong { color: #3B526D; font-size: 24rpx; font-weight: 650; }
.empty-sub { color: #71849A; font-size: 20rpx; }

.pagination { display: flex; align-items: center; justify-content: center; gap: 14rpx; margin-top: 24rpx; }
.page-btn {
  min-width: 76rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border: 2rpx solid #DFE7EF;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #50677F;
  font-size: 22rpx;
}
.page-btn-on { border-color: #1B84C9; background: #EAF4FF; color: #1B6FA8; font-weight: 700; }
.page-btn-off { opacity: .4; }
