/* 首页样式：对齐「首页.html」原型的最终计算值。
   原型按 430px 宽设计，这里按 750/430 换算成 rpx，保证各机型比例一致。 */
@import "/styles/home-icons.wxss";

page { background: #F5F9FF; }

.home-page {
  min-height: 100vh;
  padding-bottom: calc(72px + env(safe-area-inset-bottom));
  background: #F5F9FF;
  color: #152844;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* ---------- 顶部品牌栏 ---------- */
.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 108rpx;
  padding: 0 34rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #E5EDF7;
}
.brand { display: flex; align-items: center; gap: 17rpx; }
.brand-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 14rpx;
  background-color: #E3F1FF;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 32rpx 32rpx;
}
.brand-name { color: #152844; font-size: 33rpx; font-weight: 700; }

/* ---------- 主体 ---------- */
.home-main { padding: 26rpx 36rpx 0; }

/* 考试倒计时 */
.exam-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 164rpx;
  margin-bottom: 38rpx;
  padding: 29rpx 31rpx;
  border-radius: 29rpx;
  background: linear-gradient(135deg, #5E6EB8 0%, #7D83CB 58%, #A9A9DF 100%);
  box-shadow: 0 14rpx 31rpx rgba(96, 103, 184, .17);
}
.exam-copy { flex: 1; min-width: 0; }
.exam-label { display: flex; align-items: center; gap: 12rpx; color: #F0EFFF; font-size: 22rpx; }
.exam-dot { flex: 0 0 auto; width: 12rpx; height: 12rpx; border-radius: 50%; background: rgba(255, 255, 255, .62); }
.exam-title { display: block; margin-top: 12rpx; color: #FFFFFF; font-size: 28rpx; font-weight: 700; }
.exam-date { display: block; margin-top: 11rpx; color: #E2E1F8; font-size: 19rpx; line-height: 29rpx; }
.exam-count {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-left: 29rpx;
  border-left: 2rpx solid rgba(255, 255, 255, .28);
}
.exam-days { color: #FFFFFF; font-size: 58rpx; font-weight: 700; line-height: 62rpx; }
.exam-unit { margin-top: 8rpx; color: #E2E1F8; font-size: 19rpx; }

/* 分区标题 */
.section-kicker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 2rpx 18rpx;
  padding: 0 5rpx;
}
.kicker-title { color: #263D5B; font-size: 31rpx; font-weight: 750; letter-spacing: .2rpx; }
.kicker-caption { color: #8B98AA; font-size: 21rpx; }
.kicker-divided {
  margin: 20rpx 2rpx 13rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #E2E8EF;
}

/* 科目九宫格（无卡片底，图标 + 名称 + 题量） */
.tile-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 26rpx 17rpx;
  margin-bottom: 15rpx;
}
.tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
  min-height: 140rpx;
  text-align: center;
}
.tile-art {
  width: 90rpx;
  height: 90rpx;
  border-radius: 27rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 48rpx 38rpx;
}
.tile-name { color: #294563; font-size: 27rpx; font-weight: 650; line-height: 35rpx; }
.tile-count { display: none; color: #8A99AA; font-size: 19rpx; line-height: 24rpx; }
.tile-pressed { opacity: .72; }

/* 备考资源列表 */
.resource-list {
  overflow: hidden;
  border: 2rpx solid #E1EAFB;
  border-radius: 28rpx;
  background: #F5F9FF;
}
.resource-row {
  display: flex;
  align-items: center;
  min-height: 114rpx;
  padding: 19rpx 25rpx;
  background: #EEF6FF;
}
.resource-row + .resource-row { border-top: 2rpx solid #EDF2F9; }
.resource-icon {
  flex: 0 0 62rpx;
  width: 62rpx;
  height: 62rpx;
  border-radius: 19rpx;
  background-color: #E0EFFD;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 36rpx 36rpx;
}
.resource-name { flex: 1; min-width: 0; margin-left: 20rpx; color: #1F2D3D; font-size: 27rpx; font-weight: 650; }
.resource-arrow { flex: 0 0 auto; padding-left: 17rpx; color: #9AAAC0; font-size: 39rpx; line-height: 1; }

/* 资料群 */
.group-card {
  display: flex;
  align-items: center;
  margin: 42rpx 0 34rpx;
  padding: 23rpx 29rpx;
  border: 2rpx solid #E5DDFF;
  border-radius: 29rpx;
  background: #F0EDFF;
}
.group-icon {
  flex: 0 0 92rpx;
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 25rpx;
  color: #7660DF;
  background: #E0D9FF;
  font-size: 48rpx;
  font-weight: 800;
}
.group-name { flex: 1; min-width: 0; margin-left: 20rpx; color: #5E4CB0; font-size: 29rpx; font-weight: 650; }
.group-action {
  flex: 0 0 auto;
  width: 84rpx;
  height: 92rpx;
  margin-left: 19rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  border-radius: 20rpx;
  color: #7660DF;
  background: #E0D9FF;
  font-size: 25rpx;
  font-weight: 700;
  line-height: normal;
}

/* 学习趋势：原型未包含，沿用同一套卡片语言 */
.trend-card {
  padding: 19rpx 21rpx;
  border: 2rpx solid #E1EAFB;
  border-radius: 23rpx;
  background: #FFFFFF;
}
.trend-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.trend-title { color: #1F2D3D; font-size: 23rpx; font-weight: 650; }
.trend-value { max-width: 56%; color: #3277ED; font-size: 18rpx; font-weight: 700; text-align: right; }
.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 96rpx;
  margin-top: 14rpx;
  padding: 0 8rpx;
  border-bottom: 2rpx solid #EDF2F9;
}
.trend-column { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; gap: 5rpx; height: 100%; color: #8A99AA; font-size: 15rpx; }
.trend-bar { width: 30rpx; max-height: 76rpx; border-radius: 8rpx 8rpx 0 0; background: #C7DCF7; }
.trend-bar-active { background: #3277ED; }
.trend-min, .trend-label { line-height: 1.2; }
.trend-note { display: block; margin-top: 12rpx; color: #8A99AA; font-size: 17rpx; text-align: center; }

/* ---------- 加载 / 错误态 ---------- */
.home-loading, .home-error {
  display: flex;
  min-height: 60vh;
  padding: 120rpx 54rpx;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  color: #607184;
  text-align: center;
}
.loading-spinner {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 22rpx;
  border: 5rpx solid #DCE9FB;
  border-top-color: #3277ED;
  border-radius: 50%;
  animation: home-spin 1s linear infinite;
}
.error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  color: #3277ED;
  background: #E7F2FF;
  font-size: 48rpx;
  font-weight: 700;
}
.error-title { color: #152844; font-size: 31rpx; font-weight: 700; }
.error-copy { margin-top: 14rpx; color: #8A99AA; font-size: 23rpx; line-height: 1.6; }
.retry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 190rpx;
  margin-top: 32rpx;
  padding: 18rpx 28rpx;
  border-radius: 16rpx;
  color: #FFFFFF;
  background: #3277ED;
  font-size: 25rpx;
  line-height: normal;
}
@keyframes home-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

/* ---------- 资料群弹层 ---------- */
.group-modal { position: fixed; z-index: 60; inset: 0; display: flex; align-items: center; justify-content: center; padding: 32rpx; background: rgba(21, 40, 68, .67); }
.group-modal-card { position: relative; width: 100%; max-width: 584rpx; padding: 32rpx 30rpx 26rpx; border: 2rpx solid #D8E9FC; border-radius: 36rpx; color: #152844; background: #EDF6FF; box-shadow: 0 36rpx 110rpx rgba(21, 40, 68, .27); text-align: center; }
.group-modal-close { position: absolute; top: 18rpx; right: 18rpx; display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 16rpx; color: #718097; background: #FFFFFF; font-size: 36rpx; line-height: normal; }
.group-modal-kicker { display: inline-block; padding: 8rpx 16rpx; border-radius: 14rpx; color: #3277ED; background: #DCECFF; font-size: 18rpx; }
.group-modal-title { display: block; margin-top: 16rpx; font-size: 32rpx; font-weight: 700; }
.group-modal-copy { display: block; margin-top: 6rpx; color: #657A96; font-size: 20rpx; line-height: 1.5; }
.group-qr { position: relative; display: flex; align-items: center; justify-content: center; width: 252rpx; height: 252rpx; margin: 20rpx auto 14rpx; border: 2rpx dashed #A8C8EB; border-radius: 22rpx; background: #FFFFFF; }
.group-qr::before, .group-qr::after { position: absolute; width: 36rpx; height: 36rpx; border: 6rpx solid #3277ED; content: ''; }
.group-qr::before { top: 20rpx; left: 20rpx; border-right: 0; border-bottom: 0; }
.group-qr::after { right: 20rpx; bottom: 20rpx; border-left: 0; border-top: 0; }
.group-qr-text { display: flex; flex-direction: column; color: #6F83A0; font-size: 20rpx; line-height: 1.5; }
.group-qr-heading { display: block; margin-bottom: 8rpx; color: #152844; font-size: 22rpx; font-weight: 700; }
.group-qr-image-box { overflow: hidden; border-style: solid; }
.group-qr-image-box::before, .group-qr-image-box::after { display: none; }
.group-qr-image { display: block; width: 100%; height: 100%; }
.group-modal-error { display: block; margin-top: 8rpx; color: #D46B6B; font-size: 18rpx; }
.group-modal-tip { display: block; color: #3277ED; font-size: 20rpx; font-weight: 700; }
.group-modal-note { display: block; margin-top: 10rpx; color: #778AA3; font-size: 18rpx; }

/* ---------- 底部导航（覆盖公共 50px 版本，对齐原型 64px） ---------- */
.home-page .study-bottom-navigation {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  height: calc(64px + env(safe-area-inset-bottom));
  padding: 4px 8px 0;
  border-top: 1px solid #E2E8EF;
  border-radius: 0;
  background: #FFFFFF;
}
.home-page .study-bottom-navigation .study-bottom-navigation-item {
  height: 59px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  color: #95A2B0;
  font-size: 10px;
  font-weight: 700;
}
.home-page .study-bottom-navigation .nav-item-on { color: #2B8074; }
.home-page .study-bottom-navigation .nav-glyph {
  width: 22px;
  height: 22px;
  border-radius: 7px;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 18px 18px;
}
.home-page .study-bottom-navigation .nav-item-on .nav-glyph { background-color: #E2F1EC; }
.home-page .study-bottom-navigation .nav-label { font-size: 10px; line-height: 14px; color: inherit; }
