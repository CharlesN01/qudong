<template name="home-content">
<view class="home-page theme-{{theme}}" style="{{layerStyle}}">
  <safe-top />

  <view class="home-header">
    <view class="brand">
      <view class="brand-icon ico-brand"></view>
      <text class="brand-name">升本题库</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="home-loading"><view class="loading-spinner"></view><text>正在加载学习内容...</text></view>
  <view wx:elif="{{hasError}}" class="home-error">
    <view class="error-icon">!</view>
    <text class="error-title">暂时无法连接学习服务</text>
    <text class="error-copy">{{errorMessage}}</text>
    <view class="retry-button" role="button" bindtap="retry">重新加载</view>
  </view>
  <view wx:else class="home-main">
    <view class="exam-card">
      <view class="exam-copy">
        <view class="exam-label"><text class="exam-dot"></text><text>山东专升本考试倒计时</text></view>
        <text class="exam-title">你的上岸计划，今天继续</text>
        <text class="exam-date">{{config.examDate ? '演示日期 ' + config.examDate + ' · 点击设置' : '考试日期待设置'}}</text>
      </view>
      <view class="exam-count">
        <text class="exam-days">{{countdown}}</text>
        <text class="exam-unit">天后考试</text>
      </view>
    </view>

    <view class="section-kicker">
      <text class="kicker-title">选择科目</text>
      <text class="kicker-caption">从基础到冲刺</text>
    </view>
    <view class="tile-grid">
      <view wx:for="{{subjects}}" wx:key="id" class="tile" data-subject="{{item.id}}" data-name="{{item.name}}" bindtap="openSubject" hover-class="tile-pressed">
        <view class="tile-art art-{{item.id}}"></view>
        <text class="tile-name">{{item.name}}</text>
      </view>
    </view>

    <view class="section-kicker kicker-divided">
      <text class="kicker-title">备考资源</text>
      <text class="kicker-caption">资料与模考</text>
    </view>
    <view class="resource-list">
      <view wx:for="{{resources}}" wx:key="id" class="resource-row" data-page="{{item.page}}" data-name="{{item.name}}" bindtap="openResource" hover-class="tile-pressed">
        <view class="resource-icon rico-{{item.id}}"></view>
        <text class="resource-name">{{item.name}}</text>
        <text class="resource-arrow">›</text>
      </view>
    </view>

    <view class="group-card" bindtap="openGroupModal" hover-class="tile-pressed">
      <view class="group-icon">群</view>
      <text class="group-name">山东专升本资料群</text>
      <view class="group-action" role="button" catchtap="openGroupModal"><text>扫码</text><text>进群</text></view>
    </view>

    <view class="trend-card">
      <view class="trend-head"><text class="trend-title">学习趋势</text><text class="trend-value">{{trendHint}}</text></view>
      <view wx:if="{{statsReady}}" class="trend-bars"><view wx:for="{{trendBars}}" wx:key="date" class="trend-column"><text class="trend-min">{{item.minutes}}分</text><view class="trend-bar {{item.active ? 'trend-bar-active' : ''}}" style="height: {{item.height}}px;"></view><text class="trend-label">{{item.label}}</text></view></view>
      <text wx:if="{{statsReady && !trendHasData}}" class="trend-note">阅读题目或应用文正文后自动记录学习时长</text>
    </view>
    <text wx:if="{{personalError}}" class="trend-note">{{personalError}}</text>
  </view>

  <view wx:if="{{groupModalVisible}}" class="group-modal" catchtap="closeGroupModal">
    <view class="group-modal-card" catchtap="noop">
      <view class="group-modal-close" role="button" aria-label="关闭" catchtap="closeGroupModal">×</view>
      <text class="group-modal-kicker">备考资料共享</text>
      <text class="group-modal-title">山东专升本资料备考群</text>
      <text class="group-modal-copy">{{groupModalCopy}}</text>
      <view wx:if="{{groupQrCode}}" class="group-qr group-qr-image-box" bindtap="previewGroupQr">
        <image class="group-qr-image" src="{{groupQrCode}}" data-src="{{groupQrCode}}" mode="aspectFit" bindload="onGroupQrLoad" binderror="onGroupQrError" />
      </view>
      <view wx:else class="group-qr" bindtap="previewGroupQr">
        <view class="group-qr-text"><text class="group-qr-heading">微信二维码</text><text>二维码暂未配置</text></view>
      </view>
      <text wx:if="{{groupResourceError}}" class="group-modal-error">{{groupResourceError}}</text>
      <text wx:if="{{groupQrLoading}}" class="group-modal-note">二维码加载中...</text>
      <view wx:if="{{groupQrError}}" class="group-modal-error" role="button" bindtap="retryGroupQr">{{groupQrError}}</view>
      <text class="group-modal-tip">{{groupModalTip}}</text>
      <text class="group-modal-note">{{groupModalNote}}</text>
    </view>
  </view>

  <view wx:if="{{!loading && !hasError}}" class="home-nav study-bottom-navigation">
    <view class="nav-item study-bottom-navigation-item nav-item-on"><view class="nav-glyph n-ico-home"></view><text class="nav-label study-bottom-navigation-label">首页</text></view>
    <view class="nav-item study-bottom-navigation-item" data-page="favorites" bindtap="openNav"><view class="nav-glyph n-ico-fav"></view><text class="nav-label study-bottom-navigation-label">收藏</text></view>
    <view class="nav-item study-bottom-navigation-item" data-page="wrong" bindtap="openNav"><view class="nav-glyph n-ico-wrong"></view><text class="nav-label study-bottom-navigation-label">错题</text></view>
    <view class="nav-item study-bottom-navigation-item" data-page="mine" bindtap="openNav"><view class="nav-glyph n-ico-mine"></view><text class="nav-label study-bottom-navigation-label">我的</text></view>
  </view>
</view>
</template>

<template is="home-content" data="{{theme, loading, hasError, errorMessage, countdown, config, statsReady, stats, subjects, resources, resumeLabel, resumeDescription, trendHint, trendBars, trendHasData, personalError, groupModalVisible, groupModalCopy, groupQrCode, groupResourceError, groupQrLoading, groupQrError, groupModalTip, groupModalNote, layerStyle: '', navbarStyle: ''}}" />
<!-- Only the temporary upper viewport is clipped; both copies use the same layout. -->
<view wx:if="{{themeTransition}}" class="theme-reveal" style="{{themeRevealStyle}}" catchtap="noop" catchtouchmove="noop" bindtransitionend="finishThemeTransition" aria-hidden="true">
  <template is="home-content" data="{{theme, loading, hasError, errorMessage, countdown, config, statsReady, stats, subjects, resources, resumeLabel, resumeDescription, trendHint, trendBars, trendHasData, personalError, groupModalVisible, groupModalCopy, groupQrCode, groupResourceError, groupQrLoading, groupQrError, groupModalTip, groupModalNote, theme: revealTheme, layerStyle: revealContentStyle, navbarStyle: revealNavbarStyle}}" />
</view>
