.page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #293b52;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.top {
  height: 96rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-bottom: 2rpx solid #edf0f4;
}
.back {
  width: 130rpx;
  color: #57769f;
  font-size: 26rpx;
}
.top-title {
  flex: 1;
  text-align: center;
  color: #293b52;
  font-size: 32rpx;
  font-weight: 700;
}
.top-space {
  width: 130rpx;
}

.main {
  padding: 24rpx 26rpx 0;
}

/* 证书分类 */
.certs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}
.cert {
  padding: 12rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border: 2rpx solid #e7ecf2;
  border-radius: 26rpx;
  background: #ffffff;
  color: #5c7ea8;
  font-size: 24rpx;
}
.cert-on {
  border-color: #5b8fb9;
  background: #eef5fc;
  color: #2f6a9e;
  font-weight: 700;
}
.cert-tag {
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  background: #fff1e6;
  color: #b06d15;
  font-size: 18rpx;
}

/* 产品卡 */
.hero {
  display: flex;
  gap: 24rpx;
  padding: 26rpx 24rpx;
  border: 2rpx solid #e7ecf2;
  border-radius: 24rpx;
  background: #ffffff;
}
.hero-cover {
  flex: none;
  width: 200rpx;
  min-height: 240rpx;
  padding: 20rpx 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-radius: 16rpx;
  background: linear-gradient(145deg, #dceaff, #c9dcf5 65%, #e0e9fb);
  box-shadow: 0 6rpx 0 #b5cce9, 0 8rpx 16rpx rgba(70, 104, 153, 0.11);
  color: #355f91;
}
.hero-publisher,
.hero-small {
  color: #52749c;
  font-size: 18rpx;
}
.hero-strong {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.hero-line {
  color: #355f91;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}
.hero-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}
.hero-eyebrow {
  color: #a8b6c8;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}
.hero-title {
  color: #293b52;
  font-size: 34rpx;
  font-weight: 800;
}
.hero-subject {
  color: #7b8ca3;
  font-size: 24rpx;
  line-height: 1.5;
}
.hero-status {
  align-self: flex-start;
  margin-top: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: #fff4e8;
  color: #a36a2e;
  font-size: 20rpx;
}

/* 背诵入口 */
.recall {
  margin-top: 18rpx;
  padding: 24rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 2rpx solid #e7ecf2;
  border-radius: 24rpx;
  background: #ffffff;
}
.recall-icon {
  flex: none;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #eef5fc;
  color: #477bb9;
  font-size: 28rpx;
  font-weight: 700;
}
.recall-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.recall-title {
  color: #293b52;
  font-size: 28rpx;
  font-weight: 700;
}
.recall-sub {
  color: #8d9aab;
  font-size: 22rpx;
  line-height: 1.4;
}
.recall-arrow {
  flex: none;
  color: #8ba3c4;
  font-size: 36rpx;
}

/* 题型 */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 4rpx 16rpx;
}
.section-title {
  color: #293b52;
  font-size: 30rpx;
  font-weight: 700;
}
.section-caption {
  color: #909bad;
  font-size: 22rpx;
}

.types {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.type-card {
  padding: 26rpx 24rpx;
  border: 2rpx solid #e7ecf2;
  border-radius: 22rpx;
  background: #ffffff;
}
.type-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.type-name {
  color: #293b52;
  font-size: 30rpx;
  font-weight: 700;
}
.type-badge {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  background: #f0f3f7;
  color: #8d9aab;
  font-size: 20rpx;
}
.type-desc {
  display: block;
  margin-top: 10rpx;
  color: #8d9aab;
  font-size: 24rpx;
}
.type-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f0f4f9;
}
.type-count,
.type-rate {
  color: #a3b1c2;
  font-size: 22rpx;
}

/* 说明 */
.notice {
  margin-top: 28rpx;
  padding: 26rpx 24rpx;
  border: 2rpx dashed #d6e2f0;
  border-radius: 20rpx;
  background: #fafcff;
}
.notice-title {
  display: block;
  color: #5c7089;
  font-size: 26rpx;
  font-weight: 700;
}
.notice-text {
  display: block;
  margin-top: 10rpx;
  color: #93a2b5;
  font-size: 24rpx;
  line-height: 1.6;
}

.tap-dim {
  opacity: 0.88;
}
