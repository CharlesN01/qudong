<view class="favorites-page theme-{{theme}}">
  <study-navbar title="我的收藏" subtitle="" theme="paper" back="{{false}}" />

  <view class="favorites-content">
    <view class="favorites-summary">
      <text class="summary-title">我的收藏</text>
      <text class="summary-subtitle">共 {{total}} 道题，按科目归类</text>
    </view>

    <view wx:if="{{!isLogin}}" class="favorites-tip" role="button" bindtap="goLogin">登录后可同步收藏，点此登录</view>
    <view wx:if="{{loading}}" class="favorites-hint">加载中...</view>
    <view wx:if="{{error}}" class="favorites-hint favorites-hint-error">{{error}}</view>
    <view wx:if="{{isLogin && !loading && !error && !list.length}}" class="favorites-empty">还没有收藏，去刷题时点 ☆ 试试</view>

    <view wx:if="{{subjects.length}}" class="filter-row">
      <view class="filter-chip {{activeSubject === '' ? 'filter-chip-on' : ''}}" data-id="" bindtap="filterSubject">全部</view>
      <view wx:for="{{subjects}}" wx:key="id" class="filter-chip {{activeSubject === item.id ? 'filter-chip-on' : ''}}" data-id="{{item.id}}" bindtap="filterSubject">{{item.name}} {{item.count}}</view>
    </view>

    <view class="favorites-list">
      <view wx:for="{{list}}" wx:key="id" class="favorite-item">
        <view class="item-top">
          <text class="tag">{{item.subjectName || item.subjectId}}</text>
          <text class="tag tag-type">{{item.typeName}}</text>
          <text class="fav-time">{{item.lastAt}}</text>
        </view>
        <text class="stem" data-index="{{index}}" bindtap="openDetail">{{item.stemText}}</text>
        <view class="item-foot">
          <text class="chapter">{{item.chapter}}</text>
          <view class="actions">
            <view class="btn-ghost" data-qid="{{item.id}}" bindtap="removeFavorite">取消收藏</view>
            <view class="btn-solid" data-index="{{index}}" bindtap="openDetail">查看</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{detailVisible}}" class="favorite-modal" catchtap="closeDetail">
    <view class="favorite-modal-card" catchtap="noop">
      <view class="favorite-modal-close" role="button" catchtap="closeDetail">×</view>
      <text class="favorite-modal-kicker">{{detailItem.subjectName || detailItem.subjectId}} · {{detailItem.chapter}}</text>
      <view class="favorite-modal-stem">
        <block wx:for="{{detailItem.stemParts}}" wx:key="index">
          <text wx:if="{{item.kind === 'text'}}">{{item.text}}</text>
          <image wx:else class="detail-image" src="{{item.url}}" mode="widthFix" data-src="{{item.url}}" bindtap="previewImage" />
        </block>
      </view>
      <view class="favorite-options">
        <view wx:for="{{detailItem.optionList}}" wx:key="key" class="favorite-option {{item.right ? 'favorite-option-right' : ''}}">
          <text class="option-key">{{item.key}}</text><text class="option-text">{{item.text}}</text>
        </view>
      </view>
      <view class="favorite-answer"><text>正确答案：{{detailItem.answerText}}</text></view>
    </view>
  </view>

  <view class="favorites-footer study-bottom-navigation">
    <view class="bottom-tab study-bottom-navigation-item" data-page="home" bindtap="onTab"><text class="bottom-icon study-bottom-navigation-icon">⌂</text><text class="study-bottom-navigation-label">首页</text></view><view class="bottom-tab study-bottom-navigation-item bottom-tab-active"><text class="bottom-icon study-bottom-navigation-icon">☆</text><text class="study-bottom-navigation-label">收藏</text></view><view class="bottom-tab study-bottom-navigation-item" data-page="wrong" bindtap="onTab"><text class="bottom-icon study-bottom-navigation-icon">▤</text><text class="study-bottom-navigation-label">错题</text></view><view class="bottom-tab study-bottom-navigation-item" data-page="mine" bindtap="onTab"><text class="bottom-icon study-bottom-navigation-icon">◎</text><text class="study-bottom-navigation-label">我的</text></view>
  </view>
</view>
