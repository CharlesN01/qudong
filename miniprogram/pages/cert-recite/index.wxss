.page {
  min-height: 100vh;
  background: #f5f7fb;
  color: #293b52;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.top {
  height: 96rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-bottom: 2rpx solid #edf0f4;
}
.back {
  width: 130rpx;
  color: #57769f;
  font-size: 26rpx;
}
.top-title {
  flex: 1;
  text-align: center;
  color: #293b52;
  font-size: 32rpx;
  font-weight: 700;
}
.top-space {
  width: 130rpx;
}

.main {
  padding: 28rpx 26rpx 0;
}

.bookline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0 4rpx 22rpx;
}
.bookline-name {
  min-width: 0;
  overflow: hidden;
  color: #748195;
  font-size: 24rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bookline-count {
  flex: none;
  color: #5278ba;
  font-size: 22rpx;
  font-weight: 600;
}

.empty {
  padding: 130rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.empty-title {
  color: #5c7089;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
.empty-hint {
  color: #a3b1c2;
  font-size: 24rpx;
  text-align: center;
  line-height: 1.6;
}
.empty-btn {
  margin-top: 18rpx;
  padding: 18rpx 44rpx;
  border-radius: 16rpx;
  background: #477bb9;
  color: #ffffff;
  font-size: 26rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.point {
  padding: 26rpx 24rpx;
  border: 2rpx solid #e7ecf2;
  border-radius: 22rpx;
  background: #ffffff;
}
.point-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.point-topic {
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  background: #e9f1ff;
  color: #5278ba;
  font-size: 20rpx;
}
.point-arrow {
  color: #8ba3c4;
  font-size: 22rpx;
}
.point-q {
  display: block;
  margin-top: 16rpx;
  color: #3a4d66;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
}
.point-answer {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f2f6fc;
}
.point-a {
  display: block;
  color: #435a75;
  font-size: 26rpx;
  line-height: 1.75;
}
.keys {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}
.key {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: #fff4e8;
  color: #a36a2e;
  font-size: 20rpx;
}

.tap-dim {
  opacity: 0.88;
}
